{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "default_agent": "orchestrator",
  "skills": [
    "./.harness/skills"
  ],
  "mcp": {
    "servers": {
      "harness": {
        "type": "local",
        "command": [
          "python",
          ".harness/mcp/server.py"
        ],
        "codemode": false
      }
    }
  },
  "agents": {
    "orchestrator": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "product": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "architect": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "implementer": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "executor": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "tester": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "reviewer": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "verifier": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "explorer": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "title": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "summary": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "compaction": {
      "model": "opencode/glm-5.3-flash-free"
    }
  }
}
