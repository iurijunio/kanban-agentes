{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/raciocinio",
  "default_agent": "orchestrator",
  "skills": [
    "./.harness/skills"
  ],
  "mcp": {
    "servers": {
      "harness": {
        "type": "local",
        "command": [
          "python",
          ".harness/mcp/server.py"
        ],
        "codemode": false
      }
    }
  },
  "agents": {
    "orchestrator": {
      "model": "9router/raciocinio"
    },
    "product": {
      "model": "9router/raciocinio"
    },
    "architect": {
      "model": "9router/raciocinio"
    },
    "implementer": {
      "model": "9router/Coder"
    },
    "executor": {
      "model": "9router/Coder"
    },
    "tester": {
      "model": "9router/Coder"
    },
    "reviewer": {
      "model": "9router/Revisao"
    },
    "verifier": {
      "model": "9router/Varredura"
    },
    "explorer": {
      "model": "9router/Varredura"
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "title": {
      "model": "9router/Varredura"
    },
    "summary": {
      "model": "9router/Varredura"
    },
    "compaction": {
      "model": "9router/raciocinio"
    }
  },
  "providers": {
    "9router": {
      "name": "9router",
      "env": [
        "NINEROUTER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "raciocinio": {
          "name": "raciocinio",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "Revisao": {
          "name": "Revisao",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 128000,
            "output": 128000
          }
        },
        "Coder": {
          "name": "Coder",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 128000,
            "output": 131072
          }
        },
        "Varredura": {
          "name": "Varredura",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 128000,
            "output": 64000
          }
        },
        "Visao": {
          "name": "Visao",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 128000,
            "output": 131072
          }
        },
        "Reserva": {
          "name": "Reserva",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  }
}
